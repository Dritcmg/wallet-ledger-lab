{
  "id": null,
  "uid": "wallet-ledger-lab",
  "title": "Wallet Ledger Lab — local telemetry",
  "description": "Synthetic local demonstration. Operational observations are not a capacity benchmark. No customer, provider or wallet identifiers are metric labels.",
  "tags": [
    "local",
    "synthetic",
    "financial-integrity"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "API scrape health",
      "type": "stat",
      "description": "1 means the configured local API target was scraped successfully.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-ledger-prometheus"
      },
      "pluginVersion": "13.3.0",
      "targets": [
        {
          "expr": "up{job=\"wallet-ledger-lab\"}",
          "legendFormat": "API scrape",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-ledger-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Dependency collection health",
      "type": "timeseries",
      "description": "A failed collector retains old snapshots; consult these flags before interpreting gauges.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-ledger-prometheus"
      },
      "pluginVersion": "13.3.0",
      "targets": [
        {
          "expr": "wager_metrics_dependency_up{job=\"wallet-ledger-lab\"}",
          "legendFormat": "{{dependency}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-ledger-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Persisted transactions by status",
      "type": "timeseries",
      "description": "Current SQL rows by status, including internal OPENING. Replays do not create additional transactions.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-ledger-prometheus"
      },
      "pluginVersion": "13.3.0",
      "targets": [
        {
          "expr": "max by (status) (wager_transactions{job=\"wallet-ledger-lab\"})",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-ledger-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
