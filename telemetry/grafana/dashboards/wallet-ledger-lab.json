    {
      "id": 6,
      "title": "Observed publish delay p95",
      "type": "timeseries",
      "description": "Approximate p95 from cumulative process histogram buckets. This local synthetic sample is not a benchmark; pending age covers unpublished events.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-ledger-prometheus"
      },
      "pluginVersion": "13.3.0",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (wager_outbox_lag_seconds_bucket{job=\"wallet-ledger-lab\"})) or vector(0)",
          "legendFormat": "Publication delay p95",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-ledger-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Observed HTTP duration p95",
      "type": "timeseries",
      "description": "Approximate p95 from cumulative business-route histogram buckets since process start, excluding metrics and health. Synthetic local observations are not a production latency target.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
