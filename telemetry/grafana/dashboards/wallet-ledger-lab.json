      "datasource": {
        "type": "prometheus",
        "uid": "wallet-ledger-prometheus"
      },
      "pluginVersion": "13.3.0",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (wager_http_duration_seconds_bucket{job=\"wallet-ledger-lab\",route!~\"/health/.*|/metrics\"})) or vector(0)",
          "legendFormat": "HTTP duration p95",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "wallet-ledger-prometheus"
          },
          "editorMode": "code",
