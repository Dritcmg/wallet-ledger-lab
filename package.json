{
  "name": "wallet-ledger-lab",
  "version": "1.0.0",
  "description": "A reproducible laboratory for financial consistency, recovery and observable backend engineering.",
  "author": "Dri_Dev",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "setup:local": "bun scripts/setup-local.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "start": "bun dist/main.js",
    "dev": "bun src/main.ts",
    "start:api": "APP_ROLE=api bun dist/main.js",
    "migrate": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "queues:setup": "bun scripts/setup-queues.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests/unit",
    "test:unit": "bun test ./tests/unit",
    "test:integration": "bun test --timeout 120000 --max-concurrency 1 ./tests/integration",
    "test:all": "bun scripts/verify.ts",
    "verify": "bun scripts/verify.ts",
    "publication:check": "bun scripts/publication-check.ts",
    "portfolio:package": "bun scripts/package-portfolio.ts --apply",
    "telemetry:demo": "bun scripts/telemetry-demo.ts",
    "telemetry:check": "bun scripts/validate-telemetry.ts",
    "test:oracle": "bun test ./tests/unit/money-oracle.test.ts",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1158.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "decimal.js": "10.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "fflate": "0.8.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.5.0",
    "path-to-regexp": "8.4.2"
  }
}
